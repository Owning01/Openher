{
  "name": "openher-mobile-web",
  "private": true,
  "version": "1.0.4",
  "packageManager": "pnpm@10.32.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../build-desktop.ps1",
    "test:i18n": "node --experimental-strip-types src/i18n.test.mjs",
    "preview": "vite preview --host",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "test:ui": "node src/ui-regression.test.mjs",
    "test:settings": "node src/settings-regression.test.mjs",
    "test:model": "node src/model-regression.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rendered": "node --experimental-strip-types src/rendered.test.mjs",
    "check:contrast": "node --experimental-strip-types src/theme-contrast.mjs",
    "benchmark": "node benchmarks/runner.mjs",
    "benchmark:report": "node benchmarks/runner.mjs > benchmarks/report.txt"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.2",
    "@capacitor/cli": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/dialog": "8.0.1",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/local-notifications": "8.3.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "lowlight": "^3.3.0",
    "react": "19.2.8",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@deepseek-ai/dsh-llm-mock-server": "0.1.1-rc.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "27.3.0",
    "sharp": "^0.35.3",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "4.1.8"
  }
}
